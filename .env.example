# Copiez ce fichier en ".env" et changez les valeurs avant utilisation réelle.

# Port d'écoute du serveur
PORT=4000

# Phrase secrète utilisée pour sécuriser les connexions (à changer !)
JWT_SECRET=change-cette-phrase-secrete

# Code d'accès de l'espace administrateur (à changer après la première connexion)
ADMIN_PASSWORD=2026
